# RevenueCat — copy this file to .env.local and fill in your project's values.
# .env.local is gitignored; never commit real keys.

# Shared/default client SDK key, used on any platform that has no more specific
# key below. A RevenueCat Test Store key ("test_...") is platform-agnostic —
# one key covers iOS and Android for testing purchases without real store
# accounts — so this is usually all you need while testing.
VITE_REVENUECAT_API_KEY=

# Optional per-platform overrides for real production keys later (from
# RevenueCat dashboard > Project settings > API keys): the iOS App Store key
# ("appl_...") and the Android Play Store key ("goog_..."). Leave empty while
# using a single Test Store key above.
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=

# Identifier of the entitlement (RevenueCat dashboard > Entitlements) that unlocks
# Lomira Plus — lessons 2-18 and the full ritual history. Defaults to "plus" if unset.
VITE_REVENUECAT_ENTITLEMENT_ID=plus
