# RevenueCat — copy this file to .env.local and fill in your project's values.
# .env.local is gitignored; never commit real keys.

# Client SDK key for the iOS app, from RevenueCat dashboard > Project settings > API keys
# (the "public" App Store key, starts with "appl_"). Safe to ship in the app bundle.
VITE_REVENUECAT_IOS_API_KEY=

# Identifier of the entitlement (RevenueCat dashboard > Entitlements) that unlocks
# Lomira Plus — lessons 2-18 and the full ritual history. Defaults to "plus" if unset.
VITE_REVENUECAT_ENTITLEMENT_ID=plus
